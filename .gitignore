.pre-commit-config.yaml
__pycache__/
*.py[cod]
!.agents/
!.agents/skills/
!.agents/skills/**

# Go build cache. Created by running the eww backend tests by hand; it is
# derived data, it reaches 800M, and flake.nix's pre-commit check has
# src = ./. so anything here is copied into the store on every evaluation.
.go-build-cache/

# direnv's nix-direnv cache. Derived data: flake-inputs are store-path
# symlinks and the flake-profile files are GC roots, all rebuilt on `direnv
# reload`. Same reason as .go-build-cache above -- the pre-commit check has
# src = ./., so every tracked file here is copied into the store on each
# `nix flake check`.
.direnv/

# ccls index cache. Regenerated by the ccls LSP (modules/cli/home/nvim) as
# soon as a C/C++ file is opened here, and every entry keys off an absolute
# /nix/store path, so it goes stale on the next rebuild. Same src = ./.
# argument as above.
.ccls-cache/

# superpowers brainstorm session state: PIDs, ports, a session token and the
# HTML the local preview server rendered. Per-machine scratch with no meaning
# outside the session that produced it.
.superpowers/
