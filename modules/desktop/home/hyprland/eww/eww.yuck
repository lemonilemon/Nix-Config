(deflisten bar_state :initial '{"active_window":{"text":"","tooltip":"","class":""},"workspace_state":{"ws1_class":"empty","ws1_text":"\uf10c","ws2_class":"empty","ws2_text":"\uf10c","ws3_class":"empty","ws3_text":"\uf10c","ws4_class":"empty","ws4_text":"\uf10c","ws5_class":"empty","ws5_text":"\uf10c"},"submap":"","clock":{"time":"\uf017 --:--","date":"\uf073 ----","tooltip":""},"media":{"text":"","status":"","icon":"\uf001","class":"","tooltip":""},"ai_usage":{"text":"\udb81\ude74 --","tooltip":"AI usage data is not available yet","class":"missing","source":"missing","updated":"","periods":{"today":{"label":"Today","range":"","tokens":"--","cost":"--","agents":[]},"week":{"label":"This week","range":"","tokens":"--","cost":"--","agents":[]},"month":{"label":"This month","range":"","tokens":"--","cost":"--","agents":[]}},"agents":"--","quotas":[{"key":"claude","name":"Claude","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]},{"key":"codex","name":"Codex","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]},{"key":"antigravity","name":"Antigravity","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]}],"meta":{"pricing":"offline","refresh":"5m","status":"waiting","stale":"false","refreshing":"false"}},"cpu":"\uf2db --%","memory":{"text":"","tooltip":"","class":""},"temperature":{"text":"\uf2cb --\u00b0C","class":""},"network":{"text":"","tooltip":"","class":"","wifi_enabled":"false","connectivity":"unknown","conn_uuid":"","conn_name":"","speed":{"status":"none","down":"\u2014","up":"\u2014","latency":"\u2014","caption":"Not measured on this network"},"policy":{"status":"none","class":"quiet","caption":"Not checked on this network","detail":"Nothing has been checked on this network yet","ssh":"unknown","dns":"unknown","ipv6":"unknown"}},"volume":{"text":"","percent":0,"muted":"false","class":"","sinks":[]},"battery":{"text":"\udb80\udc84","alt":"\udb80\udc84","capacity":100,"class":"charging","status":"Unknown","time":"N/A","health":"--","power":"\u2014"},"bluetooth":{"text":"","tooltip":"","class":"","powered":"false","devices":[]},"tray_count":0,"notifications":{"paused":"false","new":0,"count":0,"groups":[]},"wallpaper":{"current":"","count":0,"rows":[]},"idle_inhibited":"false","display":{"mode":"normal","lid_inhibited":"false","status":"Normal desktop mode","class":"normal"}}' "eww-bar-backend bar")

(defvar laptop_controls "@laptopControls@")
(defvar battery_module "@batteryModule@")
(defvar wifi_controls "@wifiControls@")

; Which monitor owns each workspace, and which monitor is displaying it.
;
; Pushed by the daemon with `eww update` rather than arriving on bar_state,
; because the golden replay pinned the whole bar state as a byte-exact string in
; 46 recorded cases and a new key there would have broken all of them.
;
; That constraint is gone: narrowSnapshot in internal/replay/replay_test.go now
; compares only the keys the recording actually holds, so bar_state can grow
; again -- the network popup's speed card was the first field added since. This
; variable stays where it is because moving it now would be churn for nothing,
; not because it still has to.
;
; The default below is the daemon's zero value, and it is what renders before
; the first push and after any failed read. monitors = 0 sends every workspace
; down the single-screen path, which is byte-for-byte today's rendering.
(defvar ws_monitors '{"ws1_owner":"","ws2_owner":"","ws3_owner":"","ws4_owner":"","ws5_owner":"","ws1_active_on":"","ws2_active_on":"","ws3_active_on":"","ws4_active_on":"","ws5_active_on":"","focused":"","monitors":0}')

; The AI usage history grid, pushed by the daemon the same way ws_monitors is,
; and for the same reason plus one more.
;
; The reason it shared: a new key on bar_state.ai_usage broke 112 recorded
; golden cases across 7 entry points, and the recording cannot be regenerated.
; See ws_monitors above -- narrowSnapshot has since lifted that. The reason
; below has not been lifted and is the one that keeps this variable separate.
;
; The reason it does not: eww rebuilds every child of a `for` whenever ANY
; variable the loop expression mentions changes -- the listener watches
; collect_var_refs(), not the field path. A 53x7 grid read from bar_state would
; therefore destroy and recreate 371 cells, 53 columns and all their scopes
; every time the CPU collector ticks, which is every 7 seconds. Read from its
; own variable it rebuilds only when the history itself changes.
;
; Keep this literal in step with collect.AiHistoryDefault(). A key missing here
; reads as `null` in simplexpr rather than as absent, so `warning != ""` was
; true before the first push and the panel rendered the literal text "null" in
; the warning's yellow. The line-1 check in tests/nix/check_yuck_initial.py does
; not see this defvar, so nothing but the eye catches drift:
;
;   go run ./internal/collect/diffgen <<< '{"fn":"AiHistoryDefault","args":[]}'
(defvar ai_history '{"columns":[],"months":[],"period":{"label":"This year","range":"","tokens":"--","cost":"--","agents":[]},"days":0,"status":"waiting","warning":""}')

; Live throughput on the interface carrying the default route, pushed by the
; daemon with `eww update` like ws_monitors and ai_history above.
;
; Only the second of ai_history's two reasons applies here -- narrowSnapshot
; lifted the golden-replay one -- and it is enough on its own. This ticks every
; 2 seconds, against 7 for the fastest thing on bar_state, so carrying it there
; would tear down and rebuild every `for` reading bar_state at that rate. The
; notification list and the wallpaper grid are among them, and rebuilding those
; twice a second while one is open and being scrolled is a visible fault, not
; just a wasteful one.
;
; Keep this literal in step with collect.NetRateDefault(). The line-1 check in
; tests/nix/check_yuck_initial.py does not see this defvar, so nothing but the
; eye catches drift:
;
;   go run ./internal/collect/diffgen <<< '{"fn":"NetRateDefault","args":[]}'
;
; Write non-ASCII here as a LITERAL character, never as a \uXXXX escape. Yuck
; unescapes a string literal before the JSON in it is ever parsed, so "\u2014"
; reaches the widget as the four characters u2014 and renders as that -- checked
; against a scratch daemon, which is the only place it shows. Comparing the
; decoded JSON against the Go value passes either way, because that compares
; content and the bug is in the layer below it.
(defvar net_rate '{"down":"—","up":"—","device":""}')

(defvar show_date false)
(defvar show_quota_left false)
(defvar show_reset_exact false)
(defvar ai_usage_tab "total")
(defvar ai_usage_period "today")

(defvar tray_force_expanded false)
(defvar tray_fold_threshold 6)

(defwindow bar [output]
  :monitor 0
  :geometry (geometry
    :x "0"
    :y "8px"
    :width "100%"
    :height "34px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "eww-bar"
  (bar :output output))

(defwidget bar [output]
  (box :class "bar-window" :orientation "h" :hexpand true
    (centerbox :class "bar-root" :hexpand true
      (box :class "left" :orientation "h" :space-evenly false :halign "start" :hexpand true
        (box :class "bar-island workspace-island" :orientation "h" :space-evenly false
          (workspaces :output output)
          (label :class "submap" :visible {bar_state.submap != ""} :text {bar_state.submap}))
        (box :class "bar-island media-island" :orientation "h" :space-evenly false :visible {bar_state.media.text != ""}
          (button :class "media ${bar_state.media.class}"
            :onclick "eww-barctl --quiet media play-pause"
            :onrightclick "eww-barctl --quiet media next"
            :tooltip {bar_state.media.tooltip}
            (label :truncate true
              :text {bar_state.media.text != "" ? "${bar_state.media.icon} ${bar_state.media.text}" : ""})))
        (box :class "bar-island window-island" :orientation "h" :space-evenly false
          :visible {bar_state.active_window.text != ""}
          (label :class "active-window" :truncate true
            :tooltip {bar_state.active_window.tooltip}
            :text {bar_state.active_window.text})))
      ;; The clock lives in the centerbox center slot so its width is reserved:
      ;; GTK shrinks the truncate-labels on either side before anything can
      ;; slide under it (verified with a scratch daemon at 1600/900/700px).
      (box :class "bar-island clock-island" :orientation "h" :space-evenly false
        (button :class "clock"
          :onclick "eww update show_date=${show_date == 'true' ? 'false' : 'true'}"
          :onrightclick "eww-popup toggle calendar_popup ${output}"
          :tooltip {bar_state.clock.tooltip}
          (label :text {show_date == "true" ? bar_state.clock.date : bar_state.clock.time})))
      (box :class "right" :orientation "h" :space-evenly false :halign "end" :hexpand true
        (box :class "bar-island tray-island" :orientation "h" :space-evenly false
          (button :class "tray-toggle"
            :visible {bar_state.tray_count > tray_fold_threshold}
            :onclick "eww update tray_force_expanded=${tray_force_expanded ? false : true}"
            (label :text {(bar_state.tray_count <= tray_fold_threshold || tray_force_expanded) ? "‹" : "⋯"}))
          (revealer :transition "slideright" :duration "250ms"
            :reveal {bar_state.tray_count <= tray_fold_threshold || tray_force_expanded}
            (systray :class "tray" :icon-size 14 :spacing 8))
          (button :class "module-button notif-bell ${bar_state.notifications.paused == 'true' ? 'dnd' : (bar_state.notifications.new > 0 ? 'has-new' : '')}"
            :timeout "5s"
            :onclick "eww-popup toggle notif_center_popup ${output} && eww-barctl --quiet notif mark-seen"
            :tooltip {bar_state.notifications.paused == "true" ? "Do not disturb" : "${bar_state.notifications.count} notifications"}
            (label :text {bar_state.notifications.paused == "true" ? "󰂛" : (bar_state.notifications.new > 0 ? "󰂚 ${bar_state.notifications.new}" : "󰂜")}))
          (button :class "module-button network ${bar_state.network.class}"
            :timeout "5s" :onclick "eww-popup toggle network_popup ${output}"
            (label :truncate true :tooltip {bar_state.network.tooltip} :text {bar_state.network.text}))
          (button :class "module-button bluetooth ${bar_state.bluetooth.class}"
            :visible {bar_state.bluetooth.text != ""}
            :timeout "5s" :onclick "eww-popup toggle bluetooth_popup ${output}"
            (label :truncate true :tooltip {bar_state.bluetooth.tooltip} :text {bar_state.bluetooth.text})))
        (box :class "bar-island sys-island" :orientation "h" :space-evenly false
          (button :class "module-button ai-usage ${bar_state.ai_usage.class}"
            :timeout "5s" :onclick "eww-popup toggle ai_usage_popup ${output} && eww-barctl --quiet ai refresh"
            :tooltip {bar_state.ai_usage.tooltip}
            (label :text {bar_state.ai_usage.text}))
          (label :class "module temperature ${bar_state.temperature.class}" :text {bar_state.temperature.text})
          (button :class "module-button cpu" :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -- htop\")'"
            (label :text {bar_state.cpu}))
          (button :class "module-button memory ${bar_state.memory.class}"
            :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -- htop\")'"
            :tooltip {bar_state.memory.tooltip}
            (label :text {bar_state.memory.text})))
        (box :class "bar-island session-island" :orientation "h" :space-evenly false
          (eventbox
            :onscroll "eww-barctl --quiet volume {}"
            (button :class "module-button volume"
              :timeout "5s" :onclick "eww-popup toggle volume_popup ${output}"
              (label :text {bar_state.volume.text})))
          (button :class "module-button battery ${bar_state.battery.class}"
            :visible {battery_module == "true"}
            :timeout "5s" :onclick "eww-popup toggle battery_popup ${output}"
            (label :text {bar_state.battery.text}))
          (button :class "settings-button"
            :timeout "5s" :onclick "eww-popup toggle settings_popup ${output}"
            :tooltip "Settings"
            (label :text "󰒓"))
          (button :class "power-button" :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"wlogout\")'"
            (label :text "")))))))

(defwidget workspaces [output]
  (box :class "workspaces" :orientation "h" :space-evenly false
    (workspace :id "1" :output output :state_class {bar_state.workspace_state.ws1_class}
      :owner {ws_monitors.ws1_owner} :active_on {ws_monitors.ws1_active_on} :monitors {ws_monitors.monitors})
    (workspace :id "2" :output output :state_class {bar_state.workspace_state.ws2_class}
      :owner {ws_monitors.ws2_owner} :active_on {ws_monitors.ws2_active_on} :monitors {ws_monitors.monitors})
    (workspace :id "3" :output output :state_class {bar_state.workspace_state.ws3_class}
      :owner {ws_monitors.ws3_owner} :active_on {ws_monitors.ws3_active_on} :monitors {ws_monitors.monitors})
    (workspace :id "4" :output output :state_class {bar_state.workspace_state.ws4_class}
      :owner {ws_monitors.ws4_owner} :active_on {ws_monitors.ws4_active_on} :monitors {ws_monitors.monitors})
    (workspace :id "5" :output output :state_class {bar_state.workspace_state.ws5_class}
      :owner {ws_monitors.ws5_owner} :active_on {ws_monitors.ws5_active_on} :monitors {ws_monitors.monitors})))

; One bar per monitor, so each one answers for its own screen.
;
; Two visual channels carrying two independent facts, rather than four states
; sharing one grey ramp:
;
;   SHAPE says who owns it.   filled = this screen, ring = another screen,
;                             small dot = the workspace does not exist.
;   LIGHTNESS says its state. overlay0 empty < subtext0 has windows <
;                             green + accent being displayed here.
;
; Shape does the work colour was failing at. Judging which of two grey discs is
; lighter is slow and only possible side by side; filled against outlined
; resolves before you look directly at it. Splitting the axes also means colour
; is no longer load-bearing on its own.
;
; With fewer than two monitors -- including monitors == 0, the daemon's zero
; value and therefore what a failed read looks like -- there is no ownership
; axis to encode, so no ring is ever drawn and state_class is used verbatim.
; Docking and undocking cannot change the island's width or its vocabulary.
;
; bar_state.workspace_state.wsN_text is deliberately no longer read: the glyph
; now depends on WHICH bar is asking, which that field cannot express. It stays
; in the state because 294 recorded cases pin WorkspaceStateFromJSON and the
; golden replay cannot be regenerated.
;
; Right-click pulls the workspace onto THIS monitor. Nothing in the Hyprland
; config pins a workspace to a screen, so this is how one gets moved without a
; keybind. Left-click is unchanged and still matches MOD1+N exactly.
(defwidget workspace [id output state_class owner active_on monitors]
  (button
    :class "workspace ${monitors < 2 ? state_class : (active_on == output ? 'active' : (owner == output ? 'occupied' : (owner == '' ? 'empty' : 'elsewhere')))}"
    :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${id} })'"
    :onrightclick "hyprctl dispatch 'hl.dsp.workspace.move({ workspace = ${id}, monitor = \"${output}\" })'"
    ; The right-click is otherwise undiscoverable -- there is no room on a 24px
    ; button for a hint, and the first person to use this feature could not find
    ; it. Single line: yuck strings have no \n escape, and every multi-line
    ; tooltip on this bar is assembled in Go.
    :tooltip {monitors < 2 ? "Workspace ${id}"
              : owner == output ? "Workspace ${id}, on this screen"
              : owner == "" ? "Workspace ${id}, empty"
              : "Workspace ${id}, on ${owner}. Right-click to bring it here."}
    (label :text {monitors < 2 ? (state_class == "empty" ? "󰧟" : "")
                  : owner == "" ? "󰧟"
                  : (owner == output || active_on == output) ? ""
                  : ""})))

(defwindow popup_backdrop
  :monitor 0
  :geometry (geometry
    :x "0"
    :y "44px"
    :width "100%"
    :height "100%"
    :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-popup-backdrop"
  (eventbox :class "popup-backdrop" :timeout "5s" :onclick "eww-popup close"
    (box :hexpand true :vexpand true)))

(defwidget popup_header [icon title subtitle]
  (box :class "popup-header" :orientation "h" :space-evenly false
    (box :class "popup-mark" (label :text icon))
    (box :class "popup-title-stack" :orientation "v" :space-evenly false
      (label :class "popup-title" :halign "start" :text title)
      (label :class "popup-eyebrow" :halign "start" :text subtitle))))

(defwindow volume_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "300px" :height "240px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-volume"
  (volume_panel))

(defwidget volume_panel []
  (box :class "popup accent-volume" :orientation "v" :space-evenly false
    (popup_header :icon "" :title "Volume" :subtitle "Output level & device")
    (box :class "popup-body" :orientation "v" :space-evenly false
      (label :class "volume-value" :halign "start"
        :text {bar_state.volume.muted == "true" ? "Muted" : "${bar_state.volume.percent}%"})
      (scale :class "popup-slider volume-slider"
        :value {bar_state.volume.percent} :min 0 :max 100
        :onchange "eww-barctl --quiet volume set {}")
      (button :class "popup-action volume-mute ${bar_state.volume.muted == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet volume mute"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.volume.muted == "true" ? "󰝟" : ""})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.volume.muted == "true" ? "Unmute" : "Mute"})))
      (box :class "popup-section-label" :orientation "h" :space-evenly false
        (label :halign "start" :text "OUTPUT"))
      (box :class "volume-sinks" :orientation "v" :space-evenly false
        (for sink in {bar_state.volume.sinks}
          (button :class "popup-row volume-sink ${sink.active == 'true' ? 'active' : ''}"
            :onclick "eww-barctl --quiet volume sink ${sink.name}"
            (box :orientation "h" :space-evenly false
              (label :class "volume-sink-dot" :text {sink.active == "true" ? "●" : "○"})
              (label :class "volume-sink-name" :halign "start" :text {sink.description}))))))))

(defwindow display_mode_popup
  :monitor 0
  :geometry (geometry
    :x "12px"
    :y "50px"
    :width "300px"
    :height "252px"
    :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-display-mode"
  (display_mode_panel))

(defwidget display_mode_panel []
  (box :class "display-mode-popup" :orientation "v" :space-evenly false
    (box :class "display-mode-header" :orientation "h" :space-evenly false
      (box :class "display-mode-mark ${bar_state.display.class}"
        (label :text {bar_state.display.mode == "headless" ? "󰒲" : (bar_state.display.mode == "external" ? "󰍹" : "󰌢")}))
      (box :class "display-mode-title-stack" :orientation "v" :space-evenly false
        (label :class "display-mode-title" :halign "start" :text {bar_state.display.mode == "headless" ? "Headless server" : (bar_state.display.mode == "external" ? "External only" : "Normal desktop")})
        ; What happens if you walk away, rather than a second copy of the title.
        ; This is the line that has to move when the Hypridle button is pressed.
        (label :class "display-mode-eyebrow" :halign "start"
          :text {bar_state.display.mode == "headless" ? "Screens off, machine awake"
                  : bar_state.display.mode == "external" ? "Internal panel off, staying awake"
                  : bar_state.idle_inhibited == "true" ? "Staying awake"
                  : "Sleeps when idle"})))
    (box :class "display-mode-status" :orientation "h" :space-evenly false
      (label :class "display-mode-chip ${bar_state.idle_inhibited == 'true' ? 'active' : ''}" :text {bar_state.idle_inhibited == "true" ? "Hypridle paused" : "Hypridle active"})
      (label :class "display-mode-chip ${bar_state.display.lid_inhibited == 'true' ? 'active' : ''}" :text {bar_state.display.lid_inhibited == "true" ? "Lid ignored" : "Lid normal"}))
    ;; display.status is computed on every path and, until now, rendered
    ;; nowhere -- which is the last reason a broken display mode was invisible:
    ;; the buttons pass --quiet, :onclick discards the exit code, and the panel
    ;; had no place to say anything went wrong.
    ;;
    ;; Shown only when it is NOT one of the three resting descriptions, since
    ;; those already appear as the title above. What is left is the interesting
    ;; case: "Screens turned on", or a hyprctl failure.
    (label :class "display-mode-note" :halign "start" :wrap true
      :visible {bar_state.display.status != "Normal desktop mode"
             && bar_state.display.status != "External display mode"
             && bar_state.display.status != "Headless server mode"}
      :text {bar_state.display.status})
    ; The three modes are mutually exclusive, so they read as one radio group:
    ; same shape, one list, exactly one highlighted. Hypridle sits below the rule
    ; because it is a different axis -- picking a mode SETS the inhibitors, and
    ; this toggles one of them on its own.
    (box :class "display-mode-actions" :orientation "v" :space-evenly false
      (button :class "display-mode-action ${bar_state.display.mode == 'normal' ? 'active' : ''}"
        :onclick "eww-barctl --quiet display normal"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "󰌢")
          (label :class "display-mode-action-label" :halign "start" :text "Normal desktop")))
      (button :class "display-mode-action ${bar_state.display.mode == 'external' ? 'active' : ''}"
        :onclick "eww-barctl --quiet display external"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "󰍹")
          (label :class "display-mode-action-label" :halign "start" :text "External only")))
      (button :class "display-mode-action ${bar_state.display.mode == 'headless' ? 'active' : ''}"
        :onclick "eww-barctl --quiet display headless"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "󰒲")
          (label :class "display-mode-action-label" :halign "start" :text "Headless server"))))
    (box :class "display-mode-footer" :orientation "h" :space-evenly false
      (button :class "display-mode-footer-action ${bar_state.idle_inhibited == 'true' ? 'active' : ''}"
        :hexpand true
        :onclick "eww-barctl --quiet idle toggle"
        (label :text {bar_state.idle_inhibited == "true" ? "󰤄  Resume Hypridle" : "󰅶  Pause Hypridle"})))))

(defwidget bluetooth_panel []
  (box :class "popup accent-bluetooth" :orientation "v" :space-evenly false
    (popup_header :icon "󰂯" :title "Bluetooth"
      :subtitle {bar_state.bluetooth.powered == "true" ? "Powered on" : "Powered off"})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (button :class "popup-action bluetooth-power ${bar_state.bluetooth.powered == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet bluetooth power-toggle"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.bluetooth.powered == "true" ? "󰂯" : "󰂲"})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.bluetooth.powered == "true" ? "Turn off" : "Turn on"})))
      (box :class "popup-section-label" :orientation "h" :space-evenly false
        (label :halign "start" :text "CONNECTED"))
      (box :class "bluetooth-devices" :orientation "v" :space-evenly false
        (box :class "popup-empty" :orientation "h" :space-evenly false
          :visible {arraylength(bar_state.bluetooth.devices) == 0}
          (label :halign "start" :text "No connected devices"))
        (for device in {bar_state.bluetooth.devices}
          (box :class "popup-row bluetooth-device" :orientation "h" :space-evenly false
            (label :class "bluetooth-device-name" :halign "start" :text {device.name})
            (label :class "bluetooth-device-battery" :visible {device.battery != ""} :text {device.battery})
            (button :class "bluetooth-disconnect" :halign "end" :hexpand true
              :onclick "eww-barctl --quiet bluetooth disconnect ${device.mac}"
              (label :text "󰅖")))))
      (button :class "popup-footer-action"
        :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"blueman-manager\")'"
        (label :text "Open blueman")))))

(defwindow bluetooth_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "300px" :height "230px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-bluetooth"
  (bluetooth_panel))

;; One line of the throughput column: glyph, figure, unit.
;;
;; Three labels in a fixed-width row rather than one formatted string, because
;; a right-aligned string leaves the glyphs ragged whenever the two figures
;; differ in width -- "120" above "8.4" pushed the arrows a character apart.
;; Pinning the width lets the glyph hold the left edge and the unit the right,
;; with the figure right-aligned between them, so only the digits move.
(defwidget network_rate_line [icon value]
  (box :class "network-rate-line" :orientation "h" :space-evenly false :width 70
    (label :class "network-rate-icon" :text icon)
    (label :class "network-rate-value" :halign "end" :hexpand true :text value)
    (label :class "network-rate-unit" :text "Mb/s")))

;; One metric of the speed card. The unit sits UNDER the figure rather than
;; beside it: three metrics and a button share the card's ~246px of inner
;; width, and a trailing "Mb/s" on each would not fit.
;;
;; Latency carries no glyph where the other two do, and that is a decision
;; rather than an omission. At the 9px this row renders, md-timer-outline
;; collapses into an indistinct dot -- the "interior detail finer than about two
;; pixels" that appIcons in internal/collect/impure.go warns about. The arrows
;; survive because they are two strokes; "ms" needs no icon to be unambiguous.
(defwidget speedtest_metric [icon unit value muted]
  (box :class "speedtest-metric" :orientation "v" :space-evenly false
    (label :class "speedtest-value ${muted ? 'muted' : ''}" :halign "start" :text value)
    (box :class "speedtest-unit-row" :orientation "h" :space-evenly false :halign "start"
      (label :class "speedtest-unit-icon" :visible {icon != ""} :text icon)
      (label :class "speedtest-unit" :text unit))))

;; Always rendered -- with the radio off, with no connection, and with nothing
;; ever measured on this network.
;;
;; That is what keeps the geometry simple. A defwindow takes a fixed height and
;; default.nix already templates two of them because the Wi-Fi row is optional;
;; a card that appeared only after a run would need a third, plus a dead band
;; inside the popup whenever it was hidden. One placeholder state costs nothing
;; and removes the problem entirely.
(defwidget speedtest_card []
  (box :class "speedtest-card" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (box :class "speedtest-metrics" :orientation "h" :space-evenly false
        (speedtest_metric :icon "󰇚" :unit "Mb/s" :muted {bar_state.network.speed.status != "ready"}
          :value {bar_state.network.speed.down})
        (speedtest_metric :icon "󰕒" :unit "Mb/s" :muted {bar_state.network.speed.status != "ready"}
          :value {bar_state.network.speed.up})
        (speedtest_metric :icon "" :unit "ms"
          :muted {bar_state.network.speed.status != "ready"
                   && bar_state.network.speed.status != "running"}
          :value {bar_state.network.speed.latency}))
      ;; Inside the card, top right, the way ai-usage-refresh sits in the AI
      ;; header. A popup-action row of its own would cost 40px of window height
      ;; for a button pressed once a week.
      ;;
      ;; The tooltip states the data cost BEFORE the click, not after. On a
      ;; capped hotel line or a phone hotspot that is the number worth knowing.
      (button :class "speedtest-run ${bar_state.network.speed.status == 'running' ? 'busy' : ''}"
        :halign "end" :valign "start" :hexpand true
        :onclick "eww-barctl --quiet network speedtest"
        :tooltip {bar_state.network.speed.status == "running"
                   ? "Testing…" : "Speed test — uses about 70 MB"}
        (label :text "󰓅")))
    ;; ai-usage-loading-bar reused wholesale: same sapphire, same 3px, same
    ;; 0.9s alternate pulse. Two loading indicators in one bar should not be two
    ;; different animations.
    (box :class "speedtest-loading" :orientation "h" :space-evenly false
      (box :class "speedtest-loading-bar ${bar_state.network.speed.status == 'running' ? 'busy' : ''}"
        :hexpand true))
    (label :class "speedtest-caption ${bar_state.network.speed.status == 'running' ? 'live' : ''}"
      :halign "start" :truncate true :text {bar_state.network.speed.caption})
    ;; What the network ALLOWS, under what it can do.
    ;;
    ;; One line rather than the row of SSH/DNS/IPv6 chips this replaced. Three
    ;; coloured dots needed a legend the popup had nowhere to put, spent most of
    ;; their pixels saying things worked, and rendered an ordinary v4-only
    ;; network as a grey dot beside two green ones -- which reads as a fault.
    ;;
    ;; The line names a consequence and goes quiet when there is nothing to say;
    ;; all three findings live in the tooltip, which is read deliberately.
    (label :class "policy-line ${bar_state.network.policy.class}"
      :halign "start" :truncate true
      :tooltip {bar_state.network.policy.detail}
      :text {bar_state.network.policy.caption})))

(defwidget network_panel []
  (box :class "popup accent-network" :orientation "v" :space-evenly false
    (popup_header :icon "" :title "Network"
      ;; The subtitle answers what joining an unfamiliar network actually
      ;; raises. A captive portal reads as "connected" everywhere else on the
      ;; desktop, which is how an evening gets spent blaming the Wi-Fi for a
      ;; sign-in page nobody ever saw. NetworkManager already knows; this is
      ;; only asking it.
      :subtitle {bar_state.network.class == "disconnected" ? "Disconnected"
                  : bar_state.network.connectivity == "portal" ? "Sign-in required"
                  : bar_state.network.connectivity == "limited" ? "No internet"
                  : bar_state.network.connectivity == "none" ? "No internet"
                  : "Connected"})
    (box :class "popup-body" :orientation "v" :space-evenly false
      ;; Identity on the left, live throughput on the right.
      ;;
      ;; A column rather than a row of its own, and that is the whole reason the
      ;; meter cost no window height: the card had ~130px of dead space to the
      ;; right of the SSID, and a stacked pair of 10px readings fits inside it.
      ;; A third line would have meant a third @networkPopupHeight@ measurement.
      ;;
      ;; The left labels truncate now that they share the row. Without it a long
      ;; SSID pushes the rate off the edge instead of ellipsising itself.
      (box :class "network-card" :orientation "h" :space-evenly false
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "network-primary" :halign "start" :truncate true
            :text {bar_state.network.text != "" ? bar_state.network.text : "No connection"})
          (label :class "network-detail" :halign "start" :truncate true
            :text {bar_state.network.tooltip}))
        ;; Mb/s, matching the speed card below, so the two can be read against
        ;; each other -- "9.6 of a measured 86" is the useful comparison, and
        ;; MB/s here would make it silently wrong by a factor of eight.
        (box :class "network-rate" :orientation "v" :space-evenly false
          :halign "end" :valign "center"
          :tooltip {net_rate.device != "" ? "Live throughput on ${net_rate.device}"
                     : "No interface carrying the default route"}
          (network_rate_line :icon "󰇚" :value {net_rate.down})
          (network_rate_line :icon "󰕒" :value {net_rate.up})))
      (speedtest_card)
      (button :class "popup-action network-wifi ${bar_state.network.wifi_enabled == 'true' ? 'active' : ''}"
        :visible {wifi_controls == "true"}
        :onclick "eww-barctl --quiet network wifi-toggle"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.network.wifi_enabled == "true" ? "" : "󰖪"})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.network.wifi_enabled == "true" ? "Wi-Fi on" : "Wi-Fi off"})))
      ;; Behind a portal the footer stops offering the thing you do not need and
      ;; offers the thing you do. The URL is NetworkManager's own connectivity
      ;; check target -- precisely the request a portal intercepts -- so opening
      ;; it is what surfaces the sign-in page rather than a cached tab.
      (button :class "popup-footer-action ${bar_state.network.connectivity == 'portal' ? 'portal' : ''}"
        :onclick {bar_state.network.connectivity == "portal"
                   ? "hyprctl dispatch 'hl.dsp.exec_cmd(\"xdg-open http://nmcheck.gnome.org/check_network_status.txt\")'"
                   : "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -- nmtui\")'"}
        (label :text {bar_state.network.connectivity == "portal"
                       ? "Sign in to network" : "Advanced…"})))))

(defwindow network_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "300px" :height "@networkPopupHeight@" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-network"
  (network_panel))

(defwidget battery_row [label value]
  ; "--" means no data source, as opposed to "N/A", which means the reading does
  ; not apply right now -- time-to-empty on a battery that is full. The first is
  ; worth hiding, the second is worth saying. In practice this hides Health on
  ; any laptop whose firmware pins charge_full to charge_full_design.
  (box :class "popup-row battery-row" :orientation "h" :space-evenly false
    :visible {value != "--"}
    (label :class "battery-row-label" :halign "start" :text label)
    (label :class "battery-row-value" :halign "end" :hexpand true :text value)))

(defwidget battery_panel []
  (box :class "popup accent-battery" :orientation "v" :space-evenly false
    (popup_header :icon "󰁹" :title "Battery" :subtitle {bar_state.battery.status})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (box :class "battery-headline" :orientation "h" :space-evenly false
        (label :class "battery-capacity" :text "${bar_state.battery.capacity}%")
        (label :class "battery-status" :halign "end" :hexpand true :text {bar_state.battery.status}))
      (progress :class "popup-meter battery-meter ${bar_state.battery.class}" :value {bar_state.battery.capacity})
      (box :class "battery-rows" :orientation "v" :space-evenly false
        (battery_row :label "Time" :value {bar_state.battery.time})
        (battery_row :label "Health" :value {bar_state.battery.health})
        (battery_row :label "Power draw" :value {bar_state.battery.power})))))

(defwindow calendar_popup
  ;; Anchored center, unlike every other popup: the clock sits in the
  ;; centerbox's center slot, and a popup that opens under its own button is
  ;; the whole reason this replaced a separate gsimplecal window.
  :monitor 0
  :geometry (geometry :x "0" :y "50px" :width "300px" :height "330px" :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-calendar"
  (calendar_panel))

;; No :day/:month/:year bindings on purpose. Binding them to bar_state.clock
;; would snap the view back to today on every clock tick, one minute after you
;; navigated away from it. Unbound, GTK starts the widget on today, the heading
;; arrows move freely, and eww-popup's close-then-open cycle rebuilds the window
;; so reopening lands on today again -- which is the behaviour you want from
;; something whose whole job is looking up a date.
(defwidget calendar_panel []
  (box :class "popup accent-clock" :orientation "v" :space-evenly false
    (popup_header :icon "󰃭" :title "Calendar" :subtitle {bar_state.clock.tooltip})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (calendar :class "calendar"
        :show-heading true
        :show-day-names true
        ;; ISO week numbers: the one thing a desktop calendar can tell a
        ;; developer that a wall calendar cannot.
        :show-week-numbers true))))

(defwindow battery_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "280px" :height "220px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-battery"
  (battery_panel))

(defwindow notif_center_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "340px" :height "420px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-notifications"
  (notif_center_panel))

(defwidget notif_center_panel []
  (box :class "popup accent-notif notif-center" :orientation "v" :space-evenly false
    (box :class "popup-header" :orientation "h" :space-evenly false
      (box :class "popup-mark" (label :text "󰂚"))
      (box :class "popup-title-stack" :orientation "v" :space-evenly false
        (label :class "popup-title" :halign "start" :text "Notifications")
        (label :class "popup-eyebrow" :halign "start"
          :text {bar_state.notifications.paused == "true" ? "Do not disturb" : "${bar_state.notifications.count} in history"}))
      (box :class "notif-header-actions" :orientation "h" :space-evenly false :halign "end" :hexpand true
        (button :class "notif-dnd ${bar_state.notifications.paused == 'true' ? 'active' : ''}"
          :onclick "eww-barctl --quiet notif dnd-toggle"
          :tooltip {bar_state.notifications.paused == "true" ? "Resume notifications" : "Do not disturb"}
          (label :text "󰂛"))
        (button :class "notif-clear-all"
          :onclick "eww-barctl --quiet notif clear-all"
          :tooltip "Clear all"
          (label :text "󰎟"))))
    (box :class "popup-empty notif-empty" :orientation "h" :space-evenly false
      :visible {arraylength(bar_state.notifications.groups) == 0}
      (label :halign "start" :text "No notifications"))
    (scroll :class "notif-scroll" :vscroll true :hscroll false :vexpand true
      :visible {arraylength(bar_state.notifications.groups) > 0}
      (box :class "notif-groups" :orientation "v" :space-evenly false
        (for group in {bar_state.notifications.groups}
          (notif_group :group group))))))

(defwidget notif_group [group]
  (box :class "notif-group" :orientation "v" :space-evenly false
    (box :class "notif-group-header" :orientation "h" :space-evenly false
      (button :class "notif-group-toggle" :hexpand true
        :onclick "eww-barctl --quiet notif toggle-group '${group.app}'"
        (box :orientation "h" :space-evenly false
          (label :class "notif-group-app" :halign "start" :text {group.app})
          (label :class "notif-group-count" :text {group.count})
          (label :class "notif-group-chevron" :halign "end" :hexpand true
            :text {group.collapsed == "true" ? "▸" : "▾"})))
      (button :class "notif-group-clear"
        :onclick "eww-barctl --quiet notif clear-group '${group.app}'"
        :tooltip "Clear group"
        (label :text "󰅖")))
    (revealer :transition "slidedown" :duration "200ms" :reveal {group.collapsed != "true"}
      (box :class "notif-items" :orientation "v" :space-evenly false
        (for item in {group.items}
          (notif_item :item item))))))

(defwidget notif_item [item]
  (box :class "notif-item ${item.urgency == 'CRITICAL' ? 'critical' : ''}" :orientation "h" :space-evenly false
    (box :class "notif-item-body" :orientation "v" :space-evenly false :hexpand true
      (box :orientation "h" :space-evenly false
        (label :class "notif-item-summary" :halign "start" :text {item.summary})
        (label :class "notif-item-age" :halign "end" :hexpand true :text {item.age}))
      (label :class "notif-item-text" :halign "start" :visible {item.body != ""} :text {item.body}))
    (button :class "notif-item-dismiss" :valign "start"
      :onclick "eww-barctl --quiet notif dismiss ${item.id}"
      (label :text "󰅖"))))

(defwindow wallpaper_picker_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "340px" :height "300px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-wallpaper"
  (wallpaper_panel))

(defwidget wallpaper_panel []
  (box :class "popup accent-wallpaper wallpaper-picker" :orientation "v" :space-evenly false
    (box :class "popup-header" :orientation "h" :space-evenly false
      (box :class "popup-mark" (label :text "󰸉"))
      (box :class "popup-title-stack" :orientation "v" :space-evenly false
        (label :class "popup-title" :halign "start" :text "Wallpapers")
        (label :class "popup-eyebrow" :halign "start" :text "${bar_state.wallpaper.count} in ~/Pictures/wallpapers"))
      (button :class "wallpaper-open-folder" :halign "end" :hexpand true
        :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"nemo ~/Pictures/wallpapers\")'"
        :tooltip "Open folder"
        (label :text "")))
    (box :class "popup-empty wallpaper-empty" :orientation "h" :space-evenly false
      :visible {arraylength(bar_state.wallpaper.rows) == 0}
      (label :halign "start" :text "Drop images into ~/Pictures/wallpapers"))
    (scroll :class "wallpaper-scroll" :vscroll true :hscroll false :vexpand true
      :visible {arraylength(bar_state.wallpaper.rows) > 0}
      (box :class "wallpaper-grid" :orientation "v" :space-evenly false
        (for row in {bar_state.wallpaper.rows}
          (box :class "wallpaper-row" :orientation "h" :space-evenly false
            (for item in {row}
              (wallpaper_cell :item item))))))))

(defwidget wallpaper_cell [item]
  (button :class "wallpaper-cell ${item.active == 'true' ? 'active' : ''}"
    :timeout "5s"
    :onclick "eww-barctl --quiet wallpaper set '${item.path}' && eww-popup close"
    :tooltip {item.name}
    (overlay
      ;; eww overlays size to their FIRST child; an invisible first child
      ;; collapses the whole cell — keep this fixed-size frame first.
      (box :class "wallpaper-thumb-frame" :width 92 :height 58)
      (image :visible {item.thumb != ""} :path {item.thumb} :image-width 92 :image-height 58)
      (label :class "wallpaper-thumb-missing" :visible {item.thumb == ""} :text "󰸉")
      (label :class "wallpaper-badge" :visible {item.animated == "true"}
        :halign "end" :valign "start" :text "▶"))))

(defwindow settings_popup
  :monitor 0
  :geometry (geometry :x "12px" :y "50px" :width "280px" :height "210px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-settings"
  (settings_panel))

(defwidget settings_panel []
  (box :class "popup accent-settings" :orientation "v" :space-evenly false
    (popup_header :icon "󰒓" :title "Settings" :subtitle "Quick controls")
    (box :class "popup-body" :orientation "v" :space-evenly false
      (button :class "popup-action" :timeout "5s"
        :onclick "eww-barctl --quiet wallpaper rescan && eww-popup toggle wallpaper_picker_popup"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text "󰸉")
          (label :class "popup-action-label" :halign "start" :text "Wallpapers")))
      (button :class "popup-action" :timeout "5s" :visible {laptop_controls == "true"}
        :onclick "eww-popup toggle display_mode_popup"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text "󰍹")
          (label :class "popup-action-label" :halign "start" :text "Display mode")))
      (button :class "popup-action settings-idle ${bar_state.idle_inhibited == 'true' ? 'active' : ''}" :timeout "5s"
        :visible {laptop_controls != "true"}
        :onclick "eww-barctl --quiet idle toggle"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text "")
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.idle_inhibited == "true" ? "Resume Hypridle" : "Pause Hypridle"})))
      (button :class "popup-action" :timeout "5s"
        :onclick "hyprctl dispatch 'hl.dsp.exec_cmd(\"nwg-displays\")' && eww-popup close"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text "󰍺")
          (label :class "popup-action-label" :halign "start" :text "Monitor layout"))))))

(defwindow ai_usage_popup
  :monitor 0
  :geometry (geometry
    :x "12px"
    :y "50px"
    ;; 380px because every other popup in this bar is 280-340 wide, and a popup
    ;; at 540 reads as a different kind of object from its siblings rather than
    ;; as one of them. That width buys 26 week-columns at a 10px cell -- GitHub's
    ;; own cell size -- instead of 53 at 7px.
    ;;
    ;; Only the GRAPH is six months. The Year period's numbers still cover a full
    ;; 365 days; see historyDays in aiheatmap.go.
    ;;
    ;; Both numbers are MINIMUMS, not sizes -- GTK will not shrink a window below
    ;; its content's natural width, so a window is only as small as its widest
    ;; child lets it be. The header's eyebrow used to be "Subscriptions and local
    ;; activity", which held this popup at ~480px however small :width was set;
    ;; it is shorter and truncating now for that reason alone.
    ;;
    ;; 400 rather than 380 for the same reason, and it fixes a visible defect:
    ;; at 380 some tabs' content was fractionally WIDER than the request, so the
    ;; window came out 380/382/383 depending on which tab was open. The tab strip
    ;; is space-evenly, so every icon redistributed across the new width and the
    ;; four icons visibly jumped when switching tabs. Above every tab's natural
    ;; width the request wins outright and the window is the same size always.
    ;;
    ;; KNOWN: the popup's height varies with its content and neither of the two
    ;; obvious levers pins it. Measured at 380px wide: Today ~500, Claude ~527,
    ;; Year ~537, because Year lists five agent rows where Today lists two.
    ;;
    ;; Raising :height does not help -- 560 was tried and the periods still came
    ;; out 36px apart -- because GTK sizes a layer-shell window from the
    ;; hierarchy's NATURAL height, while eww's :height is a set_size_request,
    ;; which is a MINIMUM. A `min-height` on .ai-usage-popup was tried for the
    ;; same reason and ignored for the same reason: also a minimum.
    ;;
    ;; What would actually work is giving the short periods real height -- a
    ;; spacer sized to the difference, or padding each period panel to a common
    ;; natural height. Not done: it hard-codes one layout's measurements into
    ;; four widgets, and the period row sits ABOVE the part that changes, so
    ;; nothing moves under the pointer when it grows.
    ;;
    ;; 460px tall, not 420: the History summary has to hold a total row, a date
    ;; range, an optional unpriced-models warning and five agent rows above the
    ;; footer. At 420 the warning displaced the last agent row into the scroll,
    ;; where it is invisible until hover -- measured, not estimated. The other
    ;; four tabs carry the extra dead space; they are secondary views and the
    ;; popup is still ~12% of a 1920x1200 screen.
    :width "400px"
    :height "460px"
    :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-ai-usage"
  (ai_usage_panel))

(defwidget ai_usage_panel []
  (box :class "ai-usage-popup" :orientation "v" :space-evenly false
    (box :class "ai-usage-header" :orientation "h" :space-evenly false
      (box :class "ai-usage-mark"
        (label :text "󰙴"))
      (box :class "ai-usage-title-stack" :orientation "v" :space-evenly false
        (label :class "ai-usage-title" :halign "start" :text "AI usage")
        ;; Shortened AND truncating, because this label was silently setting the
        ;; window's width. GTK will not shrink a window below its content's
        ;; natural size, so "Subscriptions and local activity" held the popup at
        ;; ~480px no matter what :width said -- the geometry was a suggestion the
        ;; header overruled. Truncate lets the label give way; the shorter text
        ;; means it never has to.
        (label :class "ai-usage-eyebrow" :halign "start" :truncate true
          :text "Quotas and usage"))
      (box :class "ai-usage-header-actions" :orientation "h" :space-evenly false :halign "end" :hexpand true
        (label :class "ai-usage-updated" :text {bar_state.ai_usage.updated != "" ? "Updated ${bar_state.ai_usage.updated}" : "Waiting"})
        (button :class "ai-usage-refresh ${bar_state.ai_usage.meta.refreshing == 'true' ? 'busy' : ''}"
          :onclick "eww-barctl --quiet ai refresh"
          :tooltip {bar_state.ai_usage.meta.refreshing == "true" ? "Refreshing…" : "Refresh usage"}
          (label :text ""))))
    ;; Four tabs: one aggregate view, then the three per-provider drill-downs.
    ;; History was briefly a fifth tab of its own; it is now the year grid at the
    ;; top of this one, with the period row below choosing which slice the
    ;; numbers describe. Same information, one fewer place to look.
    (box :class "ai-usage-tabs" :orientation "h" :space-evenly true
      (button :class "ai-usage-tab ${ai_usage_tab == 'total' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=total"
        :tooltip "Total usage"
        (image :path "${EWW_CONFIG_DIR}/assets/total.svg" :image-width 18 :image-height 18))
      (button :class "ai-usage-tab ${ai_usage_tab == 'claude' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=claude"
        :tooltip "Claude subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/claude.svg" :image-width 18 :image-height 18))
      (button :class "ai-usage-tab ${ai_usage_tab == 'codex' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=codex"
        :tooltip "Codex subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/codex.svg" :image-width 18 :image-height 18))
      (button :class "ai-usage-tab ${ai_usage_tab == 'antigravity' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=antigravity"
        :tooltip "Antigravity subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/antigravity.svg" :image-width 18 :image-height 18)))
    (box :class "ai-usage-loading" :orientation "h" :space-evenly false
      :visible {bar_state.ai_usage.meta.refreshing == "true"}
      (box :class "ai-usage-loading-bar" :hexpand true))
    (box :class "ai-usage-total" :orientation "v" :space-evenly false :visible {ai_usage_tab == "total"}
      (heat_card)
      (box :class "ai-usage-period-tabs" :orientation "h" :space-evenly true
        (button :class "ai-usage-period-tab ${ai_usage_period == 'today' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=today"
          (label :text "Today"))
        (button :class "ai-usage-period-tab ${ai_usage_period == 'week' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=week"
          (label :text "Week"))
        (button :class "ai-usage-period-tab ${ai_usage_period == 'month' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=month"
          (label :text "Month"))
        ;; The year comes from ai_history rather than bar_state. It is the same
        ;; AiPeriod shape, but renders through year_panel rather than
        ;; period_panel: it reaches back far enough to surface every agent ever
        ;; run, and five agents with a progress bar each is 185px where five
        ;; compact rows are 90.
        (button :class "ai-usage-period-tab ${ai_usage_period == 'year' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=year"
          (label :text "Year")))
      (period_panel :period {bar_state.ai_usage.periods.today} :key "today")
      (period_panel :period {bar_state.ai_usage.periods.week} :key "week")
      (period_panel :period {bar_state.ai_usage.periods.month} :key "month")
      (year_panel))
    ;; Gated on the provider tabs by name rather than on `!= "total"`, so the
    ;; vexpand'd scroll contributes no empty band on the aggregate tab.
    (scroll :class "ai-usage-scroll" :vscroll true :hscroll false :vexpand true
      :visible {ai_usage_tab == "claude" || ai_usage_tab == "codex" || ai_usage_tab == "antigravity"}
      (box :class "ai-usage-content" :orientation "v" :space-evenly false
        (box :class "ai-section-heading" :orientation "h" :space-evenly false
          (label :class "ai-section-title" :text "Subscription")
          (label :class "ai-section-note" :halign "end" :hexpand true
            :text {show_quota_left == "true" ? "remaining" : "used"}))
        ;; Static cards (one per provider) rather than a `for` over the quotas
        ;; array: eww re-appends regenerated `for` children to the end of the
        ;; parent on every array update, which can leave the active tab blank.
        ;; The provider set is fixed, so index into the array directly.
        (box :class "ai-quota-list" :orientation "v" :space-evenly false
          (quota_card :quota {bar_state.ai_usage.quotas[0]})
          (quota_card :quota {bar_state.ai_usage.quotas[1]})
          (quota_card :quota {bar_state.ai_usage.quotas[2]}))))
    (box :class "ai-usage-footer" :orientation "h" :space-evenly false
      (label :text {bar_state.ai_usage.agents != "--" ? "Active · ${bar_state.ai_usage.agents}" : "No local activity"})
      (label :halign "end" :hexpand true :text {"Refresh ${bar_state.ai_usage.meta.refresh}"}))))

;; The contribution-graph tab: 53 week-columns of 7 days, oldest on the left.
;;
;; Nested `for`, matching the wallpaper grid above -- and the nesting has to be
;; for -> box -> for, because a `for` may not be the direct body of another
;; `for` and its body must be exactly one widget. The inner loop iterates the
;; outer binding directly, so the backing Go value is [][]HeatCell rather than
;; a list of objects with a cells field.
;;
;; Both loops read `ai_history` and nothing else. That is deliberate: eww
;; watches every variable a loop expression mentions and rebuilds all children
;; on any change, so touching bar_state here would rebuild 424 widgets every 7
;; seconds. See the defvar comment at the top of this file.
;;
;; Cell colour comes from a CSS class, never from :style -- eww compiles a
;; :style prop with a full SCSS pass per widget per update, which would be 371
;; compiles on every refresh.
(defwidget heat_card []
  (box :class "ai-heat-card" :orientation "v" :space-evenly false
    (box :class "ai-heat-months" :orientation "h" :space-evenly false :halign "center"
      (for month in {ai_history.months}
        (label :class "ai-heat-month" :halign "start" :width {month.width} :text {month.label})))
    (box :class "ai-heat-grid" :orientation "h" :space-evenly false :spacing 2 :halign "center"
      (for column in {ai_history.columns}
        (box :class "ai-heat-col" :orientation "v" :space-evenly false :spacing 2
          (for cell in {column}
            (box :class "ai-heat-cell ${cell.class}" :tooltip {cell.tooltip})))))
    (box :class "ai-heat-legend" :orientation "h" :space-evenly false
      (label :class "ai-heat-legend-text" :text {ai_history.days > 0 ? "${ai_history.days} active days" : "No recorded usage yet"})
      (box :orientation "h" :space-evenly false :halign "end" :hexpand true :spacing 1
        (label :class "ai-heat-legend-text" :text "Less")
        (box :class "ai-heat-cell")
        (box :class "ai-heat-cell level-1")
        (box :class "ai-heat-cell level-2")
        (box :class "ai-heat-cell level-3")
        (box :class "ai-heat-cell level-4")
        (label :class "ai-heat-legend-text" :text "More")))
    ;; The only place the panel can admit its costs are short, and it sits with
    ;; the graph rather than in a period because it is true of every period:
    ;; ccusage prices a model it does not know at exactly zero and says nothing
    ;; about it in --json mode, which is how $616 of spend read as free for
    ;; weeks.
    (label :class "ai-heat-warning" :halign "start" :wrap true
      :visible {ai_history.warning != ""} :text {ai_history.warning})))

(defwidget quota_card [quota]
  (box :class "ai-provider-section ${quota.key} ${quota.class}" :orientation "v" :space-evenly false
    :visible {ai_usage_tab == quota.key}
    (box :class "ai-quota-head" :orientation "h" :space-evenly false
      (label :class "ai-provider-dot ${quota.class}" :text "●")
      (label :class "ai-quota-provider" :text {quota.name})
      (label :class "ai-quota-plan-chip" :visible {quota.plan != "--"} :text {quota.plan})
      (label :class "ai-quota-status ${quota.class}" :halign "end" :hexpand true
        :text {quota.status == "live" ? quota.updated : quota.status}))
    (box :class "ai-quota-card ${quota.class}" :orientation "v" :space-evenly false
      (box :class "ai-quota-empty" :orientation "v" :space-evenly false
        :visible {arraylength(quota.windows) == 0 && arraylength(quota.meta) == 0}
        (label :class "ai-quota-empty-text"
          :text {bar_state.ai_usage.meta.refreshing == "true" ? "Loading…"
                  : quota.status == "waiting" ? "Waiting for first update…"
                  : quota.status == "live" ? "No usage in the current window"
                  : quota.status}))
      (for window in {quota.windows}
        (quota_meter :window window))
      (for item in {quota.meta}
        (box :class "ai-quota-meta-row" :orientation "h" :space-evenly false
          (label :class "ai-quota-meta-label" :text {item.label})
          (label :class "ai-quota-meta-value ${item.class}" :halign "end" :hexpand true
            :tooltip {item.tooltip} :text {item.value}))))))

(defwidget quota_meter [window]
  (box :class "ai-quota-window" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "ai-usage-meter-name" :text {window.label})
      (label :class "ai-quota-window-warning ${window.class}" :halign "end" :hexpand true
        :visible {window.class == "critical" || window.class == "warning"}
        :text {window.class == "critical" ? " limit near" : "usage high"}))
    (progress :class "ai-usage-meter-progress quota ${window.class}" :value {window.percent})
    (box :class "ai-quota-window-reading" :orientation "h" :space-evenly false
      (button :class "ai-quota-value ${window.class}"
        :onclick "eww --config '${EWW_CONFIG_DIR}' update show_quota_left=${show_quota_left == 'true' ? 'false' : 'true'}"
        :tooltip {show_quota_left == "true" ? "Show used" : "Show remaining"}
        (label :text {show_quota_left == "true" ? "${100 - window.percent}% left" : "${window.percent}% used"}))
      (button :class "ai-quota-reset" :halign "end" :hexpand true
        :visible {window.remaining != "--"}
        :onclick "eww --config '${EWW_CONFIG_DIR}' update show_reset_exact=${show_reset_exact == 'true' ? 'false' : 'true'}"
        :tooltip {show_reset_exact == "true" ? "Show countdown" : window.reset}
        (label :text {show_reset_exact == "true" ? window.reset : "Resets in ${window.remaining}"})))))

(defwidget period_panel [period key]
  (box :class "ai-usage-period" :orientation "v" :space-evenly false
    :visible {ai_usage_period == key}
    (box :class "ai-usage-summary-row" :orientation "h" :space-evenly false
      (box :class "ai-usage-summary-title" :orientation "v" :space-evenly false
        (label :class "ai-usage-summary-label" :halign "start" :text {period.label})
        (label :class "ai-usage-summary-source" :halign "start"
          :text {period.range != "" ? period.range : "Local token activity"}))
      (box :class "ai-usage-summary-total" :orientation "v" :space-evenly false :halign "end" :hexpand true
        (label :class "ai-usage-summary-value" :halign "end" :text {period.tokens})
        (label :class "ai-usage-summary-cost" :halign "end" :text {period.cost})))
    (box :class "ai-usage-agents" :orientation "v" :space-evenly false
      (box :class "ai-usage-agent-empty" :orientation "v" :space-evenly false
        :visible {arraylength(period.agents) == 0}
        (label :class "ai-quota-empty-text"
          :text {bar_state.ai_usage.meta.refreshing == "true" ? "Loading…" : "No local activity"}))
      (for agent in {period.agents}
        (agent_row :agent agent)))))

;; The year's own panel. Same data shape as period_panel, deliberately denser:
;; the longer window surfaces more agents, and at five rows the per-agent bars
;; overflow the popup. The bars are kept for today/week/month, where two or
;; three rows is the norm.
(defwidget year_panel []
  (box :class "ai-usage-period ai-year" :orientation "v" :space-evenly false
    :visible {ai_usage_period == "year"}
    (box :class "ai-usage-summary-row" :orientation "h" :space-evenly false
      (box :class "ai-usage-summary-title" :orientation "v" :space-evenly false
        (label :class "ai-usage-summary-label" :halign "start" :text {ai_history.period.label})
        (label :class "ai-usage-summary-source" :halign "start"
          :text {ai_history.period.range != "" ? ai_history.period.range : "Local token activity"}))
      (box :class "ai-usage-summary-total" :orientation "v" :space-evenly false :halign "end" :hexpand true
        (label :class "ai-usage-summary-value" :halign "end" :text {ai_history.period.tokens})
        (label :class "ai-usage-summary-cost" :halign "end" :text {ai_history.period.cost})))
    (box :class "ai-year-agents" :orientation "v" :space-evenly false
      (label :class "ai-quota-empty-text" :halign "start"
        :visible {arraylength(ai_history.period.agents) == 0} :text "No recorded usage yet")
      (for agent in {ai_history.period.agents}
        (box :class "ai-year-row ${agent.key}" :orientation "h" :space-evenly false
          (label :class "ai-usage-agent-dot ${agent.key}" :text "●")
          (label :class "ai-usage-agent-name" :text {agent.name})
          (label :class "ai-year-tokens" :halign "end" :hexpand true :text {agent.tokens})
          (label :class "ai-year-cost" :text {agent.cost}))))))

(defwidget agent_row [agent]
  (box :class "ai-usage-agent ${agent.key}" :orientation "v" :space-evenly false
    (box :class "ai-usage-agent-row" :orientation "h" :space-evenly false
      (label :class "ai-usage-agent-dot ${agent.key}" :text "●")
      (label :class "ai-usage-agent-name" :text {agent.name})
      (label :class "ai-usage-agent-tokens" :halign "end" :hexpand true :text {agent.tokens})
      (label :class "ai-usage-agent-cost" :text {agent.cost}))
    (progress :class "ai-usage-agent-bar ${agent.key}" :value {agent.percent})))
