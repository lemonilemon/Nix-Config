(deflisten bar_state :initial '{"active_window":{"text":"","tooltip":"","class":""},"workspace_state":{"ws1_class":"empty","ws1_text":"","ws2_class":"empty","ws2_text":"","ws3_class":"empty","ws3_text":"","ws4_class":"empty","ws4_text":"","ws5_class":"empty","ws5_text":""},"submap":"","clock":{"time":" --:--","date":" ----","tooltip":""},"media":{"text":"","status":"","icon":"","class":"","tooltip":""},"ai_usage":{"text":"󰙴 --","tooltip":"AI usage data is not available yet","class":"missing","source":"missing","updated":"","periods":{"today":{"label":"Today","range":"","tokens":"--","cost":"--","agents":[]},"week":{"label":"This week","range":"","tokens":"--","cost":"--","agents":[]},"month":{"label":"This month","range":"","tokens":"--","cost":"--","agents":[]}},"agents":"--","quotas":[{"key":"claude","name":"Claude","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]},{"key":"codex","name":"Codex","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]},{"key":"antigravity","name":"Antigravity","plan":"--","status":"waiting","class":"missing","updated":"","windows":[],"meta":[]}],"meta":{"pricing":"offline","refresh":"5m","status":"waiting","stale":"false","refreshing":"false"}},"cpu":" --%","memory":{"text":"","tooltip":"","class":""},"temperature":{"text":"","class":""},"network":{"text":"","tooltip":"","class":"","wifi_enabled":"false"},"volume":{"text":"","percent":0,"muted":"false","class":"","sinks":[]},"battery":{"text":"","alt":"","capacity":100,"class":"","status":"Unknown","time":"N/A","health":"--","power":"—"},"bluetooth":{"text":"","tooltip":"","class":"","powered":"false","devices":[]},"idle_inhibited":"false","display":{"mode":"normal","lid_inhibited":"false","status":"Normal desktop mode","class":"normal"}}' "eww-bar-backend bar")

(defvar laptop_controls "@laptopControls@")

(defvar show_date false)
(defvar show_quota_left false)
(defvar show_reset_exact false)
(defvar ai_usage_tab "total")
(defvar ai_usage_period "today")

(defwindow bar [output]
  :monitor 0
  :geometry (geometry
    :x "0"
    :y "8px"
    :width "100%"
    :height "34px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "eww-bar"
  (bar :output output))

(defwidget bar [output]
  (box :class "bar-window" :orientation "h" :hexpand true
    (centerbox :class "bar-root" :hexpand true
      (box :class "left" :orientation "h" :space-evenly false :halign "start" :hexpand true
        (box :class "bar-island workspace-island" :orientation "h" :space-evenly false
          (workspaces)
          (label :class "submap" :visible {bar_state.submap != ""} :text {bar_state.submap}))
        (box :class "bar-island media-island" :orientation "h" :space-evenly false :visible {bar_state.media.text != ""}
          (button :class "media ${bar_state.media.class}"
            :onclick "eww-barctl --quiet media play-pause"
            :onrightclick "eww-barctl --quiet media next"
            :tooltip {bar_state.media.tooltip}
            (label :text {bar_state.media.text != "" ? "${bar_state.media.icon} ${bar_state.media.text}" : ""})))
        (box :class "bar-island window-island" :orientation "h" :space-evenly false
          :visible {bar_state.active_window.text != ""}
          (label :class "active-window"
            :tooltip {bar_state.active_window.tooltip}
            :text {bar_state.active_window.text})))
      (box :class "center" :orientation "h" :space-evenly false :halign "center"
        (box :class "bar-island clock-island" :orientation "h" :space-evenly false
          (button :class "clock"
            :onclick "eww update show_date=${show_date == 'true' ? 'false' : 'true'}"
            :onrightclick "hyprctl dispatch exec gsimplecal"
            :tooltip {bar_state.clock.tooltip}
            (label :text {show_date == "true" ? bar_state.clock.date : bar_state.clock.time}))))
      (box :class "right" :orientation "h" :space-evenly false :halign "end" :hexpand true
        (box :class "bar-island tray-island" :orientation "h" :space-evenly false
          (systray :class "tray" :icon-size 14 :spacing 8)
          (button :class "idle-inhibitor ${bar_state.idle_inhibited == 'true' ? 'active' : (bar_state.display.mode != 'normal' ? 'active' : '')} ${bar_state.display.class}"
            :onclick "eww-barctl --quiet idle toggle"
            :timeout "5s" :onrightclick {laptop_controls == "true" ? "eww-popup toggle display_mode_popup ${output}" : "true"}
            :tooltip {bar_state.display.mode == "normal" ? (bar_state.idle_inhibited == "true" ? "Hypridle paused" : "Hypridle active") : bar_state.display.status}
            (label :text {bar_state.display.mode == "headless" ? "󰒲" : (bar_state.display.mode == "external" ? "󰍹" : (bar_state.idle_inhibited == "true" ? "" : ""))}))
          (button :class "module-button network ${bar_state.network.class}"
            :timeout "5s" :onclick "eww-popup toggle network_popup ${output}"
            (label :tooltip {bar_state.network.tooltip} :text {bar_state.network.text}))
          (button :class "module-button bluetooth ${bar_state.bluetooth.class}"
            :visible {bar_state.bluetooth.text != ""}
            :timeout "5s" :onclick "eww-popup toggle bluetooth_popup ${output}"
            (label :tooltip {bar_state.bluetooth.tooltip} :text {bar_state.bluetooth.text})))
        (box :class "bar-island sys-island" :orientation "h" :space-evenly false
          (button :class "module-button ai-usage ${bar_state.ai_usage.class}"
            :timeout "5s" :onclick "eww-popup toggle ai_usage_popup ${output} && eww-barctl --quiet ai refresh"
            :tooltip {bar_state.ai_usage.tooltip}
            (label :text {bar_state.ai_usage.text}))
          (label :class "module temperature ${bar_state.temperature.class}" :text {bar_state.temperature.text})
          (button :class "module-button cpu" :onclick "hyprctl dispatch exec 'kitty -- htop'"
            (label :text {bar_state.cpu}))
          (button :class "module-button memory ${bar_state.memory.class}"
            :onclick "hyprctl dispatch exec 'kitty -- htop'"
            :tooltip {bar_state.memory.tooltip}
            (label :text {bar_state.memory.text})))
        (box :class "bar-island session-island" :orientation "h" :space-evenly false
          (eventbox
            :onscroll "eww-barctl --quiet volume {}"
            (button :class "module-button volume"
              :timeout "5s" :onclick "eww-popup toggle volume_popup ${output}"
              (label :text {bar_state.volume.text})))
          (button :class "module-button battery ${bar_state.battery.class}"
            :timeout "5s" :onclick "eww-popup toggle battery_popup ${output}"
            (label :text {bar_state.battery.text}))
          (button :class "power-button" :onclick "hyprctl dispatch exec wlogout"
            (label :text "")))))))

(defwidget workspaces []
  (box :class "workspaces" :orientation "h" :space-evenly false
    (workspace :id "1" :state_class {bar_state.workspace_state.ws1_class} :icon {bar_state.workspace_state.ws1_text})
    (workspace :id "2" :state_class {bar_state.workspace_state.ws2_class} :icon {bar_state.workspace_state.ws2_text})
    (workspace :id "3" :state_class {bar_state.workspace_state.ws3_class} :icon {bar_state.workspace_state.ws3_text})
    (workspace :id "4" :state_class {bar_state.workspace_state.ws4_class} :icon {bar_state.workspace_state.ws4_text})
    (workspace :id "5" :state_class {bar_state.workspace_state.ws5_class} :icon {bar_state.workspace_state.ws5_text})))

(defwidget workspace [id state_class icon]
  (button
    :class "workspace ${state_class}"
    :onclick "hyprctl dispatch workspace ${id}"
    (label :text icon)))

(defwindow popup_backdrop
  :monitor 0
  :geometry (geometry
    :x "0"
    :y "44px"
    :width "100%"
    :height "100%"
    :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-popup-backdrop"
  (eventbox :class "popup-backdrop" :timeout "5s" :onclick "eww-popup close"
    (box :hexpand true :vexpand true)))

(defwidget popup_header [icon title subtitle]
  (box :class "popup-header" :orientation "h" :space-evenly false
    (box :class "popup-mark" (label :text icon))
    (box :class "popup-title-stack" :orientation "v" :space-evenly false
      (label :class "popup-title" :halign "start" :text title)
      (label :class "popup-eyebrow" :halign "start" :text subtitle))))

(defwindow volume_popup
  :monitor 0
  :geometry (geometry :x "110px" :y "50px" :width "300px" :height "240px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-volume"
  (volume_panel))

(defwidget volume_panel []
  (box :class "popup accent-volume" :orientation "v" :space-evenly false
    (popup_header :icon "" :title "Volume" :subtitle "Output level & device")
    (box :class "popup-body" :orientation "v" :space-evenly false
      (label :class "volume-value" :halign "start"
        :text {bar_state.volume.muted == "true" ? "Muted" : "${bar_state.volume.percent}%"})
      (scale :class "popup-slider volume-slider"
        :value {bar_state.volume.percent} :min 0 :max 100
        :onchange "eww-barctl --quiet volume set {}")
      (button :class "popup-action volume-mute ${bar_state.volume.muted == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet volume mute"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.volume.muted == "true" ? "󰝟" : ""})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.volume.muted == "true" ? "Unmute" : "Mute"})))
      (box :class "popup-section-label" :orientation "h" :space-evenly false
        (label :halign "start" :text "OUTPUT"))
      (box :class "volume-sinks" :orientation "v" :space-evenly false
        (for sink in {bar_state.volume.sinks}
          (button :class "popup-row volume-sink ${sink.active == 'true' ? 'active' : ''}"
            :onclick "eww-barctl --quiet volume sink ${sink.name}"
            (box :orientation "h" :space-evenly false
              (label :class "volume-sink-dot" :text {sink.active == "true" ? "●" : "○"})
              (label :class "volume-sink-name" :halign "start" :text {sink.description}))))))))

(defwindow display_mode_popup
  :monitor 0
  :geometry (geometry
    :x "12px"
    :y "50px"
    :width "300px"
    :height "252px"
    :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-display-mode"
  (display_mode_panel))

(defwidget display_mode_panel []
  (box :class "display-mode-popup" :orientation "v" :space-evenly false
    (box :class "display-mode-header" :orientation "h" :space-evenly false
      (box :class "display-mode-mark ${bar_state.display.class}"
        (label :text {bar_state.display.mode == "headless" ? "󰒲" : (bar_state.display.mode == "external" ? "󰍹" : "")}))
      (box :class "display-mode-title-stack" :orientation "v" :space-evenly false
        (label :class "display-mode-title" :halign "start" :text {bar_state.display.mode == "headless" ? "Headless server" : (bar_state.display.mode == "external" ? "External only" : "Stay awake")})
        (label :class "display-mode-eyebrow" :halign "start" :text {bar_state.display.status})))
    (box :class "display-mode-status" :orientation "h" :space-evenly false
      (label :class "display-mode-chip ${bar_state.idle_inhibited == 'true' ? 'active' : ''}" :text {bar_state.idle_inhibited == "true" ? "Hypridle paused" : "Hypridle active"})
      (label :class "display-mode-chip ${bar_state.display.lid_inhibited == 'true' ? 'active' : ''}" :text {bar_state.display.lid_inhibited == "true" ? "Lid ignored" : "Lid normal"}))
    (box :class "display-mode-actions" :orientation "v" :space-evenly false
      (button :class "display-mode-action ${bar_state.idle_inhibited == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet idle toggle"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "")
          (label :class "display-mode-action-label" :halign "start" :text "Pause Hypridle")))
      (button :class "display-mode-action ${bar_state.display.mode == 'external' ? 'active' : ''}"
        :onclick "eww-barctl --quiet display external"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "󰍹")
          (label :class "display-mode-action-label" :halign "start" :text "External only")))
      (button :class "display-mode-action ${bar_state.display.mode == 'headless' ? 'active' : ''}"
        :onclick "eww-barctl --quiet display headless"
        (box :orientation "h" :space-evenly false
          (label :class "display-mode-action-icon" :text "󰒲")
          (label :class "display-mode-action-label" :halign "start" :text "Headless server"))))
    (box :class "display-mode-footer" :orientation "h" :space-evenly false
      (button :class "display-mode-footer-action"
        :onclick "eww-barctl --quiet display restore"
        (label :text "Turn screens on"))
      (button :class "display-mode-footer-action danger"
        :onclick "eww-barctl --quiet display normal && eww-popup close"
        (label :text "Exit mode")))))

(defwidget bluetooth_panel []
  (box :class "popup accent-bluetooth" :orientation "v" :space-evenly false
    (popup_header :icon "󰂯" :title "Bluetooth"
      :subtitle {bar_state.bluetooth.powered == "true" ? "Powered on" : "Powered off"})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (button :class "popup-action bluetooth-power ${bar_state.bluetooth.powered == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet bluetooth power-toggle"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.bluetooth.powered == "true" ? "󰂯" : "󰂲"})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.bluetooth.powered == "true" ? "Turn off" : "Turn on"})))
      (box :class "popup-section-label" :orientation "h" :space-evenly false
        (label :halign "start" :text "CONNECTED"))
      (box :class "bluetooth-devices" :orientation "v" :space-evenly false
        (box :class "popup-empty" :orientation "h" :space-evenly false
          :visible {arraylength(bar_state.bluetooth.devices) == 0}
          (label :halign "start" :text "No connected devices"))
        (for device in {bar_state.bluetooth.devices}
          (box :class "popup-row bluetooth-device" :orientation "h" :space-evenly false
            (label :class "bluetooth-device-name" :halign "start" :text {device.name})
            (label :class "bluetooth-device-battery" :visible {device.battery != ""} :text {device.battery})
            (button :class "bluetooth-disconnect" :halign "end" :hexpand true
              :onclick "eww-barctl --quiet bluetooth disconnect ${device.mac}"
              (label :text "󰅖")))))
      (button :class "popup-footer-action"
        :onclick "hyprctl dispatch exec blueman-manager"
        (label :text "Open blueman")))))

(defwindow bluetooth_popup
  :monitor 0
  :geometry (geometry :x "455px" :y "50px" :width "300px" :height "230px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-bluetooth"
  (bluetooth_panel))

(defwidget network_panel []
  (box :class "popup accent-network" :orientation "v" :space-evenly false
    (popup_header :icon "" :title "Network"
      :subtitle {bar_state.network.class == "disconnected" ? "Disconnected" : "Connected"})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (box :class "network-card" :orientation "v" :space-evenly false
        (label :class "network-primary" :halign "start"
          :text {bar_state.network.text != "" ? bar_state.network.text : "No connection"})
        (label :class "network-detail" :halign "start" :text {bar_state.network.tooltip}))
      (button :class "popup-action network-wifi ${bar_state.network.wifi_enabled == 'true' ? 'active' : ''}"
        :onclick "eww-barctl --quiet network wifi-toggle"
        (box :orientation "h" :space-evenly false
          (label :class "popup-action-icon" :text {bar_state.network.wifi_enabled == "true" ? "" : "󰖪"})
          (label :class "popup-action-label" :halign "start"
            :text {bar_state.network.wifi_enabled == "true" ? "Wi-Fi on" : "Wi-Fi off"})))
      (button :class "popup-footer-action"
        :onclick "hyprctl dispatch exec 'kitty -- nmtui'"
        (label :text "Advanced…")))))

(defwindow network_popup
  :monitor 0
  :geometry (geometry :x "595px" :y "50px" :width "300px" :height "200px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-network"
  (network_panel))

(defwidget battery_row [label value]
  (box :class "popup-row battery-row" :orientation "h" :space-evenly false
    (label :class "battery-row-label" :halign "start" :text label)
    (label :class "battery-row-value" :halign "end" :hexpand true :text value)))

(defwidget battery_panel []
  (box :class "popup accent-battery" :orientation "v" :space-evenly false
    (popup_header :icon "󰁹" :title "Battery" :subtitle {bar_state.battery.status})
    (box :class "popup-body" :orientation "v" :space-evenly false
      (box :class "battery-headline" :orientation "h" :space-evenly false
        (label :class "battery-capacity" :text "${bar_state.battery.capacity}%")
        (label :class "battery-status" :halign "end" :hexpand true :text {bar_state.battery.status}))
      (progress :class "popup-meter battery-meter ${bar_state.battery.class}" :value {bar_state.battery.capacity})
      (box :class "battery-rows" :orientation "v" :space-evenly false
        (battery_row :label "Time" :value {bar_state.battery.time})
        (battery_row :label "Health" :value {bar_state.battery.health})
        (battery_row :label "Power draw" :value {bar_state.battery.power})))))

(defwindow battery_popup
  :monitor 0
  :geometry (geometry :x "48px" :y "50px" :width "280px" :height "220px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-battery"
  (battery_panel))

(defwindow ai_usage_popup
  :monitor 0
  :geometry (geometry
    :x "12px"
    :y "50px"
    :width "380px"
    :height "380px"
    :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-ai-usage"
  (ai_usage_panel))

(defwidget ai_usage_panel []
  (box :class "ai-usage-popup" :orientation "v" :space-evenly false
    (box :class "ai-usage-header" :orientation "h" :space-evenly false
      (box :class "ai-usage-mark"
        (label :text "󰙴"))
      (box :class "ai-usage-title-stack" :orientation "v" :space-evenly false
        (label :class "ai-usage-title" :halign "start" :text "AI usage")
        (label :class "ai-usage-eyebrow" :halign "start" :text "Subscriptions and local activity"))
      (box :class "ai-usage-header-actions" :orientation "h" :space-evenly false :halign "end" :hexpand true
        (label :class "ai-usage-updated" :text {bar_state.ai_usage.updated != "" ? "Updated ${bar_state.ai_usage.updated}" : "Waiting"})
        (button :class "ai-usage-refresh ${bar_state.ai_usage.meta.refreshing == 'true' ? 'busy' : ''}"
          :onclick "eww-barctl --quiet ai refresh"
          :tooltip {bar_state.ai_usage.meta.refreshing == "true" ? "Refreshing…" : "Refresh usage"}
          (label :text ""))))
    (box :class "ai-usage-tabs" :orientation "h" :space-evenly true
      (button :class "ai-usage-tab ${ai_usage_tab == 'total' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=total"
        :tooltip "Total usage"
        (image :path "${EWW_CONFIG_DIR}/assets/total.svg" :image-width 15 :image-height 15))
      (button :class "ai-usage-tab ${ai_usage_tab == 'claude' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=claude"
        :tooltip "Claude subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/claude.svg" :image-width 15 :image-height 15))
      (button :class "ai-usage-tab ${ai_usage_tab == 'codex' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=codex"
        :tooltip "Codex subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/codex.svg" :image-width 15 :image-height 15))
      (button :class "ai-usage-tab ${ai_usage_tab == 'antigravity' ? 'active' : ''}" :hexpand true
        :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_tab=antigravity"
        :tooltip "Antigravity subscription"
        (image :path "${EWW_CONFIG_DIR}/assets/antigravity.svg" :image-width 15 :image-height 15)))
    (box :class "ai-usage-loading" :orientation "h" :space-evenly false
      :visible {bar_state.ai_usage.meta.refreshing == "true"}
      (box :class "ai-usage-loading-bar" :hexpand true))
    (box :class "ai-usage-total" :orientation "v" :space-evenly false :visible {ai_usage_tab == "total"}
      (box :class "ai-usage-period-tabs" :orientation "h" :space-evenly true
        (button :class "ai-usage-period-tab ${ai_usage_period == 'today' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=today"
          (label :text "Today"))
        (button :class "ai-usage-period-tab ${ai_usage_period == 'week' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=week"
          (label :text "Week"))
        (button :class "ai-usage-period-tab ${ai_usage_period == 'month' ? 'active' : ''}" :hexpand true
          :onclick "eww --config '${EWW_CONFIG_DIR}' update ai_usage_period=month"
          (label :text "Month")))
      (period_panel :period {bar_state.ai_usage.periods.today} :key "today")
      (period_panel :period {bar_state.ai_usage.periods.week} :key "week")
      (period_panel :period {bar_state.ai_usage.periods.month} :key "month"))
    (scroll :class "ai-usage-scroll" :vscroll true :hscroll false :vexpand true
      (box :class "ai-usage-content" :orientation "v" :space-evenly false
        (box :class "ai-section-heading" :orientation "h" :space-evenly false :visible {ai_usage_tab != "total"}
          (label :class "ai-section-title" :text "Subscription")
          (label :class "ai-section-note" :halign "end" :hexpand true
            :text {show_quota_left == "true" ? "remaining" : "used"}))
        ;; Static cards (one per provider) rather than a `for` over the quotas
        ;; array: eww re-appends regenerated `for` children to the end of the
        ;; parent on every array update, which can leave the active tab blank.
        ;; The provider set is fixed, so index into the array directly.
        (box :class "ai-quota-list" :orientation "v" :space-evenly false
          (quota_card :quota {bar_state.ai_usage.quotas[0]})
          (quota_card :quota {bar_state.ai_usage.quotas[1]})
          (quota_card :quota {bar_state.ai_usage.quotas[2]}))))
    (box :class "ai-usage-footer" :orientation "h" :space-evenly false
      (label :text {bar_state.ai_usage.agents != "--" ? "Active · ${bar_state.ai_usage.agents}" : "No local activity"})
      (label :halign "end" :hexpand true :text {"Refresh ${bar_state.ai_usage.meta.refresh}"}))))

(defwidget quota_card [quota]
  (box :class "ai-provider-section ${quota.key} ${quota.class}" :orientation "v" :space-evenly false
    :visible {ai_usage_tab == quota.key}
    (box :class "ai-quota-head" :orientation "h" :space-evenly false
      (label :class "ai-provider-dot ${quota.class}" :text "●")
      (label :class "ai-quota-provider" :text {quota.name})
      (label :class "ai-quota-plan-chip" :visible {quota.plan != "--"} :text {quota.plan})
      (label :class "ai-quota-status ${quota.class}" :halign "end" :hexpand true
        :text {quota.status == "live" ? quota.updated : quota.status}))
    (box :class "ai-quota-card ${quota.class}" :orientation "v" :space-evenly false
      (box :class "ai-quota-empty" :orientation "v" :space-evenly false
        :visible {arraylength(quota.windows) == 0 && arraylength(quota.meta) == 0}
        (label :class "ai-quota-empty-text"
          :text {bar_state.ai_usage.meta.refreshing == "true" ? "Loading…"
                  : quota.status == "waiting" ? "Waiting for first update…"
                  : quota.status == "live" ? "No usage in the current window"
                  : quota.status}))
      (for window in {quota.windows}
        (quota_meter :window window))
      (for item in {quota.meta}
        (box :class "ai-quota-meta-row" :orientation "h" :space-evenly false
          (label :class "ai-quota-meta-label" :text {item.label})
          (label :class "ai-quota-meta-value ${item.class}" :halign "end" :hexpand true
            :tooltip {item.tooltip} :text {item.value}))))))

(defwidget quota_meter [window]
  (box :class "ai-quota-window" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "ai-usage-meter-name" :text {window.label})
      (label :class "ai-quota-window-warning ${window.class}" :halign "end" :hexpand true
        :visible {window.class == "critical" || window.class == "warning"}
        :text {window.class == "critical" ? " limit near" : "usage high"}))
    (progress :class "ai-usage-meter-progress quota ${window.class}" :value {window.percent})
    (box :class "ai-quota-window-reading" :orientation "h" :space-evenly false
      (button :class "ai-quota-value ${window.class}"
        :onclick "eww --config '${EWW_CONFIG_DIR}' update show_quota_left=${show_quota_left == 'true' ? 'false' : 'true'}"
        :tooltip {show_quota_left == "true" ? "Show used" : "Show remaining"}
        (label :text {show_quota_left == "true" ? "${100 - window.percent}% left" : "${window.percent}% used"}))
      (button :class "ai-quota-reset" :halign "end" :hexpand true
        :visible {window.remaining != "--"}
        :onclick "eww --config '${EWW_CONFIG_DIR}' update show_reset_exact=${show_reset_exact == 'true' ? 'false' : 'true'}"
        :tooltip {show_reset_exact == "true" ? "Show countdown" : window.reset}
        (label :text {show_reset_exact == "true" ? window.reset : "Resets in ${window.remaining}"})))))

(defwidget period_panel [period key]
  (box :class "ai-usage-period" :orientation "v" :space-evenly false
    :visible {ai_usage_period == key}
    (box :class "ai-usage-summary-row" :orientation "h" :space-evenly false
      (box :class "ai-usage-summary-title" :orientation "v" :space-evenly false
        (label :class "ai-usage-summary-label" :halign "start" :text {period.label})
        (label :class "ai-usage-summary-source" :halign "start"
          :text {period.range != "" ? period.range : "Local token activity"}))
      (box :class "ai-usage-summary-total" :orientation "v" :space-evenly false :halign "end" :hexpand true
        (label :class "ai-usage-summary-value" :halign "end" :text {period.tokens})
        (label :class "ai-usage-summary-cost" :halign "end" :text {period.cost})))
    (box :class "ai-usage-agents" :orientation "v" :space-evenly false
      (box :class "ai-usage-agent-empty" :orientation "v" :space-evenly false
        :visible {arraylength(period.agents) == 0}
        (label :class "ai-quota-empty-text"
          :text {bar_state.ai_usage.meta.refreshing == "true" ? "Loading…" : "No local activity"}))
      (for agent in {period.agents}
        (agent_row :agent agent)))))

(defwidget agent_row [agent]
  (box :class "ai-usage-agent ${agent.key}" :orientation "v" :space-evenly false
    (box :class "ai-usage-agent-row" :orientation "h" :space-evenly false
      (label :class "ai-usage-agent-dot ${agent.key}" :text "●")
      (label :class "ai-usage-agent-name" :text {agent.name})
      (label :class "ai-usage-agent-tokens" :halign "end" :hexpand true :text {agent.tokens})
      (label :class "ai-usage-agent-cost" :text {agent.cost}))
    (progress :class "ai-usage-agent-bar ${agent.key}" :value {agent.percent})))
