#!/usr/bin/env python3
"""Entry point for eww-bar-backend, the eww bar's state daemon.

Only the daemon lives here. eww-barctl and eww-popup are a compiled Go binary
(../client): they are invoked from 39 eww.yuck handlers including :onscroll, and
essentially all of their latency was CPython startup -- the daemon answers a
ping in 0.06 ms, against ~45 ms of interpreter and imports spent asking it.

The daemon stays in Python because 93% of its CPU is the child processes its
collectors fork, and those cost the same in any language.
"""
import sys
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "bar"
    if mode != "bar":
        print(f"unknown backend mode: {mode}", file=sys.stderr)
        return 1

    from eww_bar_backend.app import run_bar

    run_bar()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
