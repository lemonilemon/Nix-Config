#!/usr/bin/env bash
set -euo pipefail

mode=${1:?usage: listen <media|network|volume|bluetooth>}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
poll_script="$script_dir/poll"

emit() {
  local output
  output=$(sh "$poll_script" "$1" || true)
  if [ -z "$output" ]; then
    case "$1" in
      network | bluetooth)
        output='{"text":"","tooltip":"","class":""}'
        ;;
    esac
  fi
  printf '%s\n' "$output"
}

listen_command() {
  local listen_mode=$1
  shift

  emit "$listen_mode"
  while true; do
    "$@" 2>/dev/null | while IFS= read -r _event; do
      emit "$listen_mode"
      sleep 0.2
      while IFS= read -r -t 0.2 _event; do
        :
      done
    done
    sleep 2
  done
}

listen_network() {
  local refresh_interval=${EWW_NETWORK_REFRESH_INTERVAL:-60}
  local read_status

  emit network
  while true; do
    nmcli monitor 2>/dev/null | while true; do
      if IFS= read -r -t "$refresh_interval" _event; then
        emit network
        sleep 0.2
        while IFS= read -r -t 0.2 _event; do
          :
        done
      else
        read_status=$?
        if [ "$read_status" -gt 128 ]; then
          emit network
        else
          break
        fi
      fi
    done
    sleep 2
  done
}

listen_bluetooth() {
  emit bluetooth
  while true; do
    tail -f /dev/null 2>/dev/null | bluetoothctl --monitor 2>/dev/null | while IFS= read -r _event; do
      emit bluetooth
      sleep 0.2
      while IFS= read -r -t 0.2 _event; do
        :
      done
    done
    sleep 2
  done
}

case "$mode" in
  media)
    emit media
    while true; do
      playerctl -F metadata --format '{{playerName}} {{status}} {{artist}} {{title}}' 2>/dev/null \
        | while IFS= read -r _event; do
          emit media
        done
      sleep 2
    done
    ;;
  network)
    listen_network
    ;;
  volume)
    listen_command volume pw-mon --hide-props --hide-params
    ;;
  bluetooth)
    listen_bluetooth
    ;;
  *)
    printf 'unknown listener: %s\n' "$mode" >&2
    exit 1
    ;;
esac
