json_module() {
  jq -nc \
    --arg text "$1" \
    --arg tooltip "$2" \
    --arg class "$3" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

case "$1" in
  clock)
    jq -nc \
      --arg time " $(date '+%H:%M')" \
      --arg date " $(date '+%F')" \
      --arg tooltip " $(date '+%A, %F %Z')" \
      '{time: $time, date: $date, tooltip: $tooltip}'
    ;;
  media)
    playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null \
      | head -n1 \
      | awk '{ if (length($0) > 52) printf "%s...", substr($0, 1, 49); else printf "%s", $0 }'
    ;;
  cpu)
    read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
    total1=$((user + nice + system + idle + iowait + irq + softirq + steal))
    idle1=$((idle + iowait))
    sleep 0.2
    read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
    total2=$((user + nice + system + idle + iowait + irq + softirq + steal))
    idle2=$((idle + iowait))
    awk -v total=$((total2 - total1)) -v idle=$((idle2 - idle1)) \
      'BEGIN { if (total > 0) printf " %.0f%%", (total - idle) * 100 / total; else printf " --%%" }'
    ;;
  memory)
    awk '
      /MemTotal/ { total=$2 }
      /MemAvailable/ { available=$2 }
      /SwapTotal/ { swap_total=$2 }
      /SwapFree/ { swap_free=$2 }
      END {
        pct = (total - available) / total * 100
        used_g = (total - available) / 1048576
        total_g = total / 1048576
        swap_used_g = (swap_total - swap_free) / 1048576
        swap_total_g = swap_total / 1048576
        class = ""
        if (pct >= 80) class = "critical"
        printf "{\"text\":\" %.0f%%\",\"tooltip\":\"Used: %.1fG/%.1fG\\nSwap: %.1fG/%.1fG\",\"class\":\"%s\"}", pct, used_g, total_g, swap_used_g, swap_total_g, class
      }' /proc/meminfo
    ;;
  temperature)
    max_temp=$(
      for input in /sys/class/hwmon/hwmon*/temp*_input; do
        [ -r "$input" ] && awk '{ printf "%.0f\n", $1 / 1000 }' "$input"
      done 2>/dev/null | sort -nr | head -n1
    )
    if [ -n "$max_temp" ]; then
      class=""
      [ "$max_temp" -ge 90 ] 2>/dev/null && class="critical"
      printf '{"text":" %s°C","class":"%s"}' "$max_temp" "$class"
    else
      printf '{"text":" --°C","class":""}'
    fi
    ;;
  network)
    status=$(nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null || true)
    wifi_device=$(printf '%s\n' "$status" | awk -F: '$2 == "wifi" && $3 == "connected" { print $1; exit }')
    wifi=$(
      nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null \
        | awk -F: '$1 == "yes" { print $2 "\t" $3; exit }'
    )
    if [ -n "$wifi_device" ] && [ -n "$wifi" ]; then
      ssid=${wifi%%	*}
      signal=${wifi##*	}
      ip_info=$(nmcli -t -f IP4.ADDRESS dev show "$wifi_device" 2>/dev/null | head -n1 | cut -d: -f2-)
      if [ -n "$ip_info" ]; then
        json_module " ${ssid} ${signal}%" "${wifi_device}: ${ip_info}" "wifi"
      else
        json_module "󰈀 (No IP)" "${wifi_device}: No IP" "linked"
      fi
    else
      eth=$(
        printf '%s\n' "$status" \
          | awk -F: '$2 == "ethernet" && $3 == "connected" { print $1; exit }'
      )
      if [ -n "$eth" ]; then
        ip_info=$(nmcli -t -f IP4.ADDRESS dev show "$eth" 2>/dev/null | head -n1 | cut -d: -f2)
        if [ -n "$ip_info" ]; then
          json_module "󰌗 ${eth}" "${eth}: ${ip_info}" "ethernet"
        else
          json_module "󰈀 (No IP)" "${eth}: No IP" "linked"
        fi
      else
        json_module "⚠ Disconnected" "No connection" "disconnected"
      fi
    fi
    ;;
  volume)
    wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null \
      | awk '{ volume=int($2 * 100); if ($3 == "[MUTED]") printf "󰝟"; else if (volume < 35) printf " %d%%", volume; else if (volume < 70) printf " %d%%", volume; else printf " %d%%", volume }'
    ;;
  battery)
    for bat in /sys/class/power_supply/BAT*; do
      [ -r "$bat/capacity" ] || continue
      capacity=$(cat "$bat/capacity")
      status=$(cat "$bat/status" 2>/dev/null || true)

      if [ "$status" = Charging ]; then
        icon="󰂄"
      elif [ "$capacity" -lt 20 ]; then
        icon="󰁻"
      elif [ "$capacity" -lt 40 ]; then
        icon="󰁼"
      elif [ "$capacity" -lt 60 ]; then
        icon="󰁾"
      elif [ "$capacity" -lt 80 ]; then
        icon="󰂀"
      else
        icon="󰁹"
      fi

      # Compute time remaining — supports both energy (µWh/µW) and charge (µAh/µA) interfaces
      time_str="N/A"
      now="" rate="" full_val=""
      if [ -r "$bat/energy_now" ] && [ -r "$bat/power_now" ]; then
        now=$(cat "$bat/energy_now")
        rate=$(cat "$bat/power_now")
        full_val=$(cat "$bat/energy_full" 2>/dev/null)
      elif [ -r "$bat/charge_now" ] && [ -r "$bat/current_now" ]; then
        now=$(cat "$bat/charge_now")
        rate=$(cat "$bat/current_now")
        full_val=$(cat "$bat/charge_full" 2>/dev/null)
      fi
      if [ -n "$rate" ] && [ "$rate" -gt 0 ] 2>/dev/null; then
        if [ "$status" = Discharging ]; then
          minutes=$((now * 60 / rate))
        elif [ "$status" = Charging ] && [ -n "$full_val" ] && [ "$full_val" -gt 0 ] 2>/dev/null; then
          minutes=$(( (full_val - now) * 60 / rate ))
        fi
        if [ -n "$minutes" ]; then
          time_str="$((minutes / 60))h $((minutes % 60))m"
        fi
      fi

      # CSS class for styling
      class=""
      if [ "$status" = Charging ]; then
        class="charging"
      elif [ "$capacity" -lt 20 ]; then
        class="critical"
      elif [ "$capacity" -lt 30 ]; then
        class="warning"
      fi

      printf '{"text":"%s %s%%","alt":"%s %s","capacity":%s,"class":"%s"}' \
        "$icon" "$capacity" "$icon" "$time_str" "$capacity" "$class"
      exit 0
    done
    printf '{"text":"󰂄","alt":"󰂄","capacity":100,"class":"charging"}'
    ;;
  bluetooth)
    controller=$(bluetoothctl show 2>/dev/null || true)
    controller_address=$(printf '%s\n' "$controller" | awk '/^Controller / { print $2; exit }')
    controller_alias=$(printf '%s\n' "$controller" | sed -n 's/^[[:space:]]*Alias:[[:space:]]*//p' | head -n1)
    powered=$(printf '%s\n' "$controller" | sed -n 's/^[[:space:]]*Powered:[[:space:]]*//p' | head -n1)
    [ -n "$controller_alias" ] || controller_alias="Bluetooth"

    devices=$(bluetoothctl devices Connected 2>/dev/null | sed '/^[[:space:]]*$/d' || true)
    count=$(printf '%s\n' "$devices" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')

    if [ "$count" -eq 0 ] 2>/dev/null; then
      tooltip=$(printf '%s\t%s\n\n0 connected' "$controller_alias" "${controller_address:-N/A}")
      json_module "" "$tooltip" "${powered:-off}"
      exit 0
    fi

    preferred=$(
      printf '%s\n' "$devices" \
        | awk 'BEGIN { IGNORECASE=1 } /ugreen_1|ugreen_2/ { print; exit }'
    )
    first=${preferred:-$(printf '%s\n' "$devices" | head -n1)}
    first_address=$(printf '%s\n' "$first" | awk '{ print $2 }')

    device_details() {
      line=$1
      address=$(printf '%s\n' "$line" | awk '{ print $2 }')
      fallback_alias=$(printf '%s\n' "$line" | cut -d' ' -f3-)
      info=$(bluetoothctl info "$address" 2>/dev/null || true)
      alias=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*Alias:[[:space:]]*//p' | head -n1)
      [ -n "$alias" ] || alias=$fallback_alias
      battery=$(printf '%s\n' "$info" | sed -n 's/.*Battery Percentage:.*(\([0-9][0-9]*\)).*/\1/p' | head -n1)

      if [ -n "$battery" ]; then
        printf '%s\t%s\t%s%%\n' "$alias" "$address" "$battery"
      else
        printf '%s\t%s\n' "$alias" "$address"
      fi
    }

    first_details=$(device_details "$first")
    first_alias=$(printf '%s\n' "$first_details" | awk -F'\t' '{ print $1 }')
    first_battery=$(printf '%s\n' "$first_details" | awk -F'\t' 'NF >= 3 { print $3 }')
    if [ -n "$first_battery" ]; then
      text="󰂯 ${first_alias} ${first_battery}"
    else
      text="󰂯 ${first_alias}"
    fi
    if [ "${#text}" -gt 24 ]; then
      text="$(printf '%s' "$text" | cut -c1-21)..."
    fi

    device_list=$(
      printf '%s\n' "$devices" | while IFS= read -r line; do
        [ -n "$line" ] && device_details "$line"
      done
    )
    tooltip=$(printf '%s\t%s\n\n%s connected\n\n%s' "$controller_alias" "${controller_address:-N/A}" "$count" "$device_list")
    json_module "$text" "$tooltip" "connected"
    ;;
esac
